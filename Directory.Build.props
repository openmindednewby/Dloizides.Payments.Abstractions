<Project>
  <PropertyGroup>
    <HouseArchitectureStyle>Clean</HouseArchitectureStyle>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Authors>DLoizides</Authors>
    <Company>dloizides.com</Company>
    <PackageProjectUrl>https://github.com/openmindednewby/Dloizides.Payments.Abstractions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/openmindednewby/Dloizides.Payments.Abstractions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>payments;stripe;merchant;credentials;value-objects</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Stripe-free merchant payment value objects (MerchantStripeCredentials, MerchantStripeKey, MerchantStripeSecrets) for domain projects that must not reference ASP.NET Core or Stripe.net.</Description>

    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dloizides.Analyzers" Version="0.7.3" PrivateAssets="all" />
  </ItemGroup>
</Project>

